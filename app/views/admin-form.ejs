<!doctype html><html lang="vi"><head><%- include('partials/head', { title: post ? 'Chỉnh sửa bài viết' : 'Tạo bài viết' }) %></head><body><%- include('partials/header') %><main class="container narrow"><div class="page-heading"><div><p class="eyebrow">QUẢN TRỊ</p><h1><%= post ? 'Chỉnh sửa bài viết' : 'Tạo bài viết' %></h1></div><a class="back-link" href="/admin">← Danh sách</a></div><section class="form-card"><% if (error) { %><p class="alert"><%= error %></p><% } %><form method="post" action="<%= post ? '/admin/bai-viet/' + post.id + '/sua' : '/admin/bai-viet' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="originalTitle" value="<%= post?.originalTitle || post?.title || '' %>"><label for="title">Tiêu đề</label><input id="title" name="title" maxlength="200" value="<%= post?.title || '' %>" required><label for="categoryId">Danh mục</label><select id="categoryId" name="categoryId" required><option value="">Chọn danh mục</option><% categories.forEach(category => { %><option value="<%= category.id %>" <%= Number(post?.categoryId) === category.id ? 'selected' : '' %>><%= category.name %></option><% }) %></select><label for="excerpt">Mô tả ngắn</label><textarea id="excerpt" name="excerpt" rows="3" maxlength="500"><%= post?.excerpt || '' %></textarea><label for="body">Nội dung</label><textarea id="body" name="body" rows="12" maxlength="30000" required><%= post?.body || '' %></textarea><label for="status">Trạng thái</label><select id="status" name="status"><option value="published" <%= !post || post.status === 'published' ? 'selected' : '' %>>Đăng bài</option><option value="draft" <%= post?.status === 'draft' ? 'selected' : '' %>>Lưu bản nháp</option></select><div class="form-actions"><a class="button secondary" href="/admin">Hủy</a><button class="button" type="submit">Lưu bài viết</button></div></form></section></main><%- include('partials/footer') %></body></html>
