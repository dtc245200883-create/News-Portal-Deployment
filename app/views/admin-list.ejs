<!doctype html><html lang="vi"><head><%- include('partials/head', { title: 'Quản lý bài viết' }) %></head><body><%- include('partials/header') %><main class="container"><div class="page-heading"><div><p class="eyebrow">QUẢN TRỊ</p><h1>Bài viết</h1><p class="muted">Xin chào, <%= admin.username %>.</p></div><a class="button" href="/admin/bai-viet/moi">+ Tạo bài viết</a></div><section class="table-card"><% if (posts.length) { %><div class="table-scroll"><table><thead><tr><th>Tiêu đề</th><th>Danh mục</th><th>Trạng thái</th><th>Ngày tạo</th><th></th></tr></thead><tbody><% posts.forEach(post => { %><tr><td class="title-cell"><%= post.title %></td><td><%= post.category_name %></td><td><span class="status <%= post.status %>"><%= post.status === 'published' ? 'Đã đăng' : 'Bản nháp' %></span></td><td><%= new Date(post.created_at).toLocaleDateString('vi-VN') %></td><td class="actions"><a href="/admin/bai-viet/<%= post.id %>/sua">Sửa</a><form action="/admin/bai-viet/<%= post.id %>/xoa" method="post" onsubmit="return confirm('Xóa bài viết này?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-button danger" type="submit">Xóa</button></form></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty"><h2>Chưa có bài viết</h2><a href="/admin/bai-viet/moi">Tạo bài viết đầu tiên</a></div><% } %></section></main><%- include('partials/footer') %></body></html>
