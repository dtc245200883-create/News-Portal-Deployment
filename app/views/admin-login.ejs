<!doctype html><html lang="vi"><head><%- include('partials/head', { title: 'Đăng nhập quản trị' }) %></head><body><%- include('partials/header') %><main class="container narrow"><section class="form-card"><p class="eyebrow">KHU VỰC QUẢN TRỊ</p><h1>Đăng nhập</h1><p class="muted">Đăng nhập để quản lý bài viết.</p><% if (error) { %><p class="alert"><%= error %></p><% } %><form method="post" action="/admin/login"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="username">Tên đăng nhập</label><input id="username" name="username" autocomplete="username" maxlength="100" required><label for="password">Mật khẩu</label><input id="password" type="password" name="password" autocomplete="current-password" required><button class="button" type="submit">Đăng nhập</button></form></section></main><%- include('partials/footer') %></body></html>
