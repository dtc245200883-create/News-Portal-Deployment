<!doctype html><html lang="vi"><head><%- include('partials/head', { title: post.title }) %></head><body><%- include('partials/header') %><main class="container article-wrap"><a class="back-link" href="/?category=<%= categoryNav.find(c => c.slug === post.category_slug)?.id %>">← <%= post.category_name %></a><article class="article"><p class="eyebrow"><%= post.category_name %></p><h1><%= post.title %></h1><p class="article-date">Đăng ngày <%= new Date(post.published_at || post.created_at).toLocaleDateString('vi-VN') %></p><div class="article-body"><% post.body.split(/\r?\n\r?\n/).forEach(paragraph => { %><p><%= paragraph %></p><% }) %></div></article></main><%- include('partials/footer') %></body></html>
